#!/usr/bin/env bash
#
# Keep `.gitlab-ci.yml` in step with the plugin manifests.
#
# The pipeline is derived from `plugins/*/manifest.json`, so it goes stale the moment a
# plugin is added, removed, or has its version bumped. Rather than ask anyone to remember,
# this regenerates it on every commit and stages the result, so the CI change always rides
# along with the manifest change that caused it.
#
# Installed by `scripts/install-hooks.sh` (which points `core.hooksPath` here). Bypass with
# `git commit --no-verify`, and nothing downstream will notice — this hook is the only
# thing keeping the file current.
#
# Known limitation, deliberate: the generator reads the **working tree**, not the index. If
# you stage a manifest edit while leaving a second one unstaged, the generated file
# describes both. `node scripts/generate-ci.mjs --check` says so after the fact.

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

out=".gitlab-ci.yml"
generator="scripts/generate-ci.mjs"

[ -f "$generator" ] || exit 0

if ! command -v node > /dev/null 2>&1; then
  echo "pre-commit: node is not on PATH, so $out cannot be regenerated." >&2
  echo "            Install node (the repo pins one via mise) or commit with --no-verify." >&2
  exit 1
fi

before=""
[ -f "$out" ] && before="$(git hash-object "$out")"

# A manifest this cannot make sense of fails the commit, naming the file and the reason.
node "$generator" --quiet

after=""
[ -f "$out" ] && after="$(git hash-object "$out")"

if [ "$before" != "$after" ]; then
  git add -- "$out"
  echo "pre-commit: regenerated $out from the plugin manifests and staged it."
fi
